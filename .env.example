# ArtOfSoul.N configuration. The defaults are 100% free: every AI feature runs locally through Ollama.
# Copy to backend\.env (the Windows launcher does this for you). Nothing here needs a paid account.

# --- Local AI (free) ---
OLLAMA_URL=http://localhost:11434
# One model serves every role so only one is loaded in memory. Gemma 4 can see images (needed for artwork feedback).
#   gemma4:e2b  ~8 GB RAM laptops (fastest, simplest feedback)
#   gemma4:e4b  16 GB RAM (recommended default)
#   gemma4:12b  a GPU with ~10 GB+ VRAM, or 32 GB RAM (best quality, slower on CPU)
MODEL_TEACHER=ollama:gemma4:e4b
MODEL_CURRICULUM=ollama:gemma4:e4b
MODEL_VISION=ollama:gemma4:e4b
MODEL_ASSESSMENT=ollama:gemma4:e4b
MODEL_COORDINATOR=ollama:gemma4:e4b
MODEL_EXERCISE=ollama:gemma4:e4b
OLLAMA_NUM_CTX=16384
OLLAMA_THINK=false            # true = slower, more deliberate answers
PREFETCH_NEXT_LESSON=true     # write the next lesson in the background

# --- Reference image generation (optional, free) ---
# Off by default. To enable: run Stable Diffusion WebUI / Forge locally with the --api flag, then:
#   MODEL_IMAGE=sdwebui:default
MODEL_IMAGE=none:
SD_WEBUI_URL=http://127.0.0.1:7860

# --- Security ---
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
POSTGRES_PASSWORD=artofsoul-local

# --- Optional paid or cloud alternatives (not needed) ---
# ANTHROPIC_API_KEY=         then e.g. MODEL_TEACHER=anthropic:claude-sonnet-5-5
# OPENAI_API_KEY=            then e.g. MODEL_IMAGE=openai:gpt-image-2
# OPENAI_BASE_URL=           any OpenAI-compatible server, e.g. LM Studio: http://localhost:1234/v1 (then MODEL_*=openai:<model>)
