# Copy to .env and fill in. Never commit real keys. Keys are used only by the backend.

# --- Required for AI features ---
ANTHROPIC_API_KEY=            # teacher, curriculum, vision, assessment, coordinator, exercises
OPENAI_API_KEY=               # reference image generation (optional; the rest works without it)

# --- Security ---
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
POSTGRES_PASSWORD=artofsoul-local

# --- Model roles ("provider:model"); providers: anthropic | openai (image: openai) ---
MODEL_TEACHER=anthropic:claude-sonnet-5-5
MODEL_CURRICULUM=anthropic:claude-sonnet-5-5
MODEL_VISION=anthropic:claude-sonnet-5-5
MODEL_ASSESSMENT=anthropic:claude-sonnet-5-5
MODEL_COORDINATOR=anthropic:claude-haiku-5-5
MODEL_EXERCISE=anthropic:claude-haiku-5-5
MODEL_IMAGE=openai:gpt-image-2

# --- Optional ---
# DATABASE_URL=sqlite:///./data/artofsoul.db        (default for local dev)
# ANTHROPIC_BASE_URL=
# AI_TIMEOUT_SECONDS=90
# RATE_LIMIT_AI_PER_MINUTE=12
# MAX_UPLOAD_MB=12
# CORS_ORIGINS=http://localhost:5174
